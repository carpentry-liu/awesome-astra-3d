{
  "name": "awesome-astra-3d",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build.mjs",
    "start": "vite preview --outDir dist/client --host 127.0.0.1",
    "lint": "oxlint app src components lib scripts tests vite.config.ts next.config.ts",
    "format": "oxfmt",
    "check": "node scripts/validate-data.mjs && node --test tests/*.test.mjs && tsc --noEmit",
    "catalog": "node scripts/generate-catalog.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "type": "module"
}
